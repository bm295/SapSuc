@page
@model IndexModel
@{
    ViewData["Title"] = "Home";
}

<div class="sf-home">
    <nav class="sf-home-links" aria-label="Home navigation">
        <a class="active" href="#">HomePage</a>
        <a href="#">Ask HR</a>
    </nav>

    <section class="sf-hero" aria-label="Welcome banner">
        <div class="sf-hero-overlay"></div>
        <h1>Good afternoon!</h1>
    </section>

    <section class="sf-block">
        <h2>Quick Actions</h2>
        <div class="sf-actions-grid">
            <a class="qa-tile qa-red" href="#"><span>Request Time Off</span></a>
            <a class="qa-tile qa-pink" href="#"><span>Record Time</span></a>
            <a class="qa-tile qa-purple" href="#"><span>Manage Goals</span></a>
            <a class="qa-tile qa-blue" href="#"><span>Recognize</span></a>
            <a class="qa-tile qa-slate" href="#"><span>Saved For Later</span></a>
        </div>
    </section>

    <section class="sf-block">
        <article class="sf-spotlight-card">
            <div class="sf-spotlight-copy">
                <p class="sf-eyebrow">Hiring Experience Survey</p>
                <h3>Help us to be better.</h3>
                <p>Survey ends on Jul 4, 2021</p>
                <a href="#">Start Survey</a>
            </div>
            <div class="sf-spotlight-media"></div>
        </article>
    </section>

    <section class="sf-block">
        <h2>Organizational Updates</h2>
        <div class="sf-update-grid">
            <article class="sf-update-card">
                <div class="sf-update-image image-office"></div>
                <div class="sf-update-body">
                    <h3>Office 365 Integration</h3>
                    <p>Powered by Intelligent Services</p>
                </div>
            </article>
            <article class="sf-update-card">
                <div class="sf-update-image image-hourglass"></div>
                <div class="sf-update-body">
                    <h3>Manage Pending Requests</h3>
                </div>
            </article>
            <article class="sf-update-card">
                <div class="sf-update-image image-sandbox"></div>
                <div class="sf-update-body">
                    <h3>Welcome to SAP SuccessFactors!</h3>
                    <p>Start your "sandbox" experience here.</p>
                </div>
            </article>
            <article class="sf-update-card">
                <div class="sf-update-image image-workplace"></div>
                <div class="sf-update-body">
                    <h3>Know your Workplace</h3>
                    <p>1218 Global HR solutions.</p>
                </div>
            </article>
        </div>
    </section>
</div>
