@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="error-page">
    <section class="error-page-header">
        <p class="eyebrow">System message</p>
        <h1>Unable to process request</h1>
        <p>The application could not complete the current operation.</p>
    </section>

    <section class="error-card">
        <h2>Request status</h2>
        <p>Return to Proxy Management and retry the operation.</p>

        @if (Model.ShowRequestId)
        {
            <div>
                <span class="error-code">Request ID: @Model.RequestId</span>
            </div>
        }
    </section>
</div>
