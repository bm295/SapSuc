@page "/ManagePermissionRoles/EditAdministrators"
@{
    ViewData["Title"] = "Edit Administrators";

    var categories = new[]
    {
        "Manage Competencies and Skills",
        "Manage System Properties",
        "Manage User",
        "Manage Identity Account and Group",
        "Metadata Framework",
        "Manage Business Configuration",
        "Admin Alerts Object Permissions",
        "Manage Mass Data Management",
        "Business Rules Object Permissions",
        "Diagnostic Tool",
        "Check Tool",
        "Configuration Transport Center",
        "Manage Integration Tools",
        "Manage Security",
        "Common Super Domain",
        "Admin Center Permissions",
        "Manage Extensions on SAP BTP",
        "Manage Security Center",
        "Card Service"
    };

    var permissions = new[]
    {
        new { Name = "Access Check Tool", Description = "Authorizes users to access the Check Tool.", Highlight = true },
        new { Name = "Allow Configuration Export", Description = "Authorizes users to attach configuration information to a ticket when they need to create one.", Highlight = true },
        new { Name = "Allow Check Tool Quick Fix", Description = "Authorizes users to fix configuration and data issues from Check Tool results.", Highlight = true }
    };
}

<div class="er-page">
    <nav class="er-breadcrumb" aria-label="Breadcrumb">
        <a href="/AdminCenter">Admin Center</a>
        <span>/</span>
        <a href="/ManagePermissionRoles">Manage Permission Roles</a>
        <span>/</span>
        <span>Edit Role for Administrators</span>
    </nav>

    <header class="er-header">
        <h1>Edit Administrators</h1>
    </header>

    <ol class="er-stepper" aria-label="Edit role progress">
        <li>
            <span>1</span>
            <strong>Basic Information</strong>
        </li>
        <li class="active">
            <span>2</span>
            <strong>Add Permissions</strong>
        </li>
        <li>
            <span>3</span>
            <strong>Preview</strong>
        </li>
    </ol>

    <section class="er-permissions-shell" aria-label="Add permissions">
        <aside class="er-category-pane" aria-label="Permission categories">
            <ul>
                @foreach (var category in categories)
                {
                    var isSelected = category == "Check Tool";
                    <li class="@(isSelected ? "selected" : string.Empty)">
                        <button type="button">@category</button>
                    </li>
                }
            </ul>
            <div class="er-category-scrollbar" aria-hidden="true">
                <span></span>
            </div>
        </aside>

        <div class="er-permission-pane">
            <div class="er-permission-list" role="list">
                @foreach (var permission in permissions)
                {
                    <label class="er-permission-row @(permission.Highlight ? "highlight" : string.Empty)" role="listitem">
                        <span class="er-check">
                            <input type="checkbox" checked />
                        </span>
                        <span class="er-permission-name">@permission.Name</span>
                        <span class="er-permission-description">@permission.Description</span>
                    </label>
                }
            </div>
            <div class="er-permission-scrollbar" aria-hidden="true">
                <span></span>
            </div>
        </div>
    </section>
</div>
