@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var isHomePage = currentPath.Equals("/", StringComparison.OrdinalIgnoreCase) ||
        currentPath.Contains("Index", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SapSuc HR</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SapSuc.Web.styles.css" asp-append-version="true" />
</head>
<body class="sf-body">
    <header class="sf-topbar" role="banner">
        <div class="sf-brand">
            <a class="sf-brand-home" href="/" aria-label="Go to Home Page">
                <span class="sf-logo">SAP</span>
                <span class="sf-product">SuccessFactors</span>
            </a>
            @if (isHomePage)
            {
                <span class="sf-section">Home</span>
            }
            else
            {
                <a class="sf-section" href="/AdminCenter">Admin Center</a>
            }
        </div>
        <div class="sf-search" role="search">
            <input id="global-search" type="search" aria-label="Action Search" placeholder="Search for actions or people" autocomplete="off" aria-autocomplete="list" aria-controls="global-search-suggestions" aria-expanded="false" />
            <div id="global-search-suggestions" class="sf-suggestions" role="listbox" aria-label="Search suggestions" hidden></div>
        </div>
        <div class="sf-actions" aria-label="Header actions">
            <button type="button">?</button>
            <button type="button">!</button>
            <button type="button">U</button>
        </div>
    </header>

    <main class="sf-page" role="main">
        @RenderBody()
    </main>

    <script>
        (function () {
            const input = document.getElementById('global-search');
            const box = document.getElementById('global-search-suggestions');
            if (!input || !box) return;

            const entries = [
                { label: 'Admin Center', url: '/AdminCenter' },
                { label: 'Admin Alerts', url: '/AdminAlerts' },
                { label: 'Check Tool', url: '/CheckTool' },
                { label: 'Check Tool Permissions', url: '/ManagePermissionRoles/EditAdministrators' },
                { label: 'Proxy Management', url: '/ProxyManagement' },
                { label: 'Company Settings', url: '/CompanySettings' },
                { label: 'Manage Permission Roles', url: '/ManagePermissionRoles' }
            ];

            let currentMatches = [];
            let activeIndex = -1;

            function isSubsequence(query, text) {
                let qi = 0;
                for (let ti = 0; ti < text.length && qi < query.length; ti++) {
                    if (query[qi] === text[ti]) qi++;
                }
                return qi === query.length;
            }

            function getMatches(query) {
                const q = query.trim().toLowerCase();
                if (!q) return [];
                return entries.filter(e => {
                    const label = e.label.toLowerCase();
                    return label.includes(q) || isSubsequence(q, label);
                });
            }

            function setExpanded(isExpanded) {
                input.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
            }

            function clearActiveOption() {
                activeIndex = -1;
                input.removeAttribute('aria-activedescendant');
            }

            function getSuggestionItems() {
                return Array.from(box.querySelectorAll('.sf-suggestion-item'));
            }

            function hideSuggestions() {
                box.hidden = true;
                setExpanded(false);
                clearActiveOption();
            }

            function setActiveIndex(index) {
                const items = getSuggestionItems();
                if (items.length === 0) {
                    clearActiveOption();
                    return;
                }

                activeIndex = (index + items.length) % items.length;
                items.forEach(function (item, itemIndex) {
                    const isActive = itemIndex === activeIndex;
                    item.classList.toggle('is-active', isActive);
                    item.setAttribute('aria-selected', isActive ? 'true' : 'false');
                    if (isActive) {
                        input.setAttribute('aria-activedescendant', item.id);
                        item.scrollIntoView({ block: 'nearest' });
                    }
                });
            }

            function render(matches) {
                currentMatches = matches;
                clearActiveOption();
                box.innerHTML = '';
                if (matches.length === 0) {
                    hideSuggestions();
                    return;
                }

                for (const [index, match] of matches.entries()) {
                    const btn = document.createElement('button');
                    btn.type = 'button';
                    btn.id = 'global-search-suggestion-' + index;
                    btn.className = 'sf-suggestion-item';
                    btn.textContent = match.label;
                    btn.setAttribute('role', 'option');
                    btn.setAttribute('aria-selected', 'false');
                    btn.tabIndex = -1;
                    btn.addEventListener('mouseenter', function () {
                        setActiveIndex(index);
                    });
                    btn.addEventListener('mousedown', function (e) {
                        e.preventDefault();
                    });
                    btn.addEventListener('click', function () {
                        window.location.href = match.url;
                    });
                    box.appendChild(btn);
                }

                box.hidden = false;
                setExpanded(true);
            }

            input.addEventListener('input', function () {
                render(getMatches(input.value));
            });

            input.addEventListener('keydown', function (e) {
                if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
                    if (box.hidden) {
                        render(getMatches(input.value));
                    }

                    if (currentMatches.length > 0) {
                        e.preventDefault();
                        const offset = e.key === 'ArrowDown' ? 1 : -1;
                        const startIndex = e.key === 'ArrowDown' ? 0 : currentMatches.length - 1;
                        setActiveIndex(activeIndex === -1 ? startIndex : activeIndex + offset);
                    }
                } else if (e.key === 'Enter') {
                    const matches = box.hidden ? getMatches(input.value) : currentMatches;
                    if (matches.length > 0) {
                        e.preventDefault();
                        const selectedIndex = activeIndex === -1 ? 0 : activeIndex;
                        window.location.href = matches[selectedIndex].url;
                    }
                } else if (e.key === 'Escape') {
                    hideSuggestions();
                }
            });

            document.addEventListener('click', function (e) {
                if (!box.contains(e.target) && e.target !== input) {
                    hideSuggestions();
                }
            });
        })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

