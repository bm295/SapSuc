@{
    var currentPath = Context.Request.Path.Value ?? string.Empty;
    var isProxyPage = currentPath.Equals("/", StringComparison.OrdinalIgnoreCase) ||
        currentPath.Contains("Index", StringComparison.OrdinalIgnoreCase);
    var isPrivacyPage = currentPath.Contains("Privacy", StringComparison.OrdinalIgnoreCase);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SapSuc HR</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/SapSuc.Web.styles.css" asp-append-version="true" />
</head>
<body class="fiori-body">
    <header class="shellbar" role="banner">
        <div class="shellbar-left">
            <a class="shell-logo" asp-area="" asp-page="/Index" aria-label="SapSuc HR home">
                <span class="shell-logo-mark">SH</span>
            </a>
            <div class="shell-title-block">
                <span class="shell-product">SapSuc HR</span>
                <span class="shell-subtitle">Proxy Administration</span>
            </div>
        </div>

        <div class="shell-search" role="search">
            <span class="shell-search-icon" aria-hidden="true">S</span>
            <input type="search" aria-label="Enterprise search" placeholder="Search employees, forms, assignments" />
        </div>

        <div class="shell-actions">
            <button class="shell-icon-button" type="button" aria-label="Help">?</button>
            <button class="shell-icon-button" type="button" aria-label="Notifications">!</button>
            <button class="shell-user-button" type="button" aria-label="User profile">AD</button>
        </div>
    </header>

    <div class="app-frame">
        <aside class="side-nav" aria-label="Primary navigation">
            <nav>
                <a class="side-nav-item @(isProxyPage ? "active" : string.Empty)" asp-area="" asp-page="/Index">
                    <span class="side-nav-icon" aria-hidden="true">PM</span>
                    <span>Proxy Management</span>
                </a>
                <a class="side-nav-item" asp-area="" asp-page="/Index" asp-fragment="assignment-form">
                    <span class="side-nav-icon" aria-hidden="true">+</span>
                    <span>New Assignment</span>
                </a>
                <a class="side-nav-item" asp-area="" asp-page="/Index" asp-fragment="csv-import">
                    <span class="side-nav-icon" aria-hidden="true">CSV</span>
                    <span>CSV Import</span>
                </a>
                <a class="side-nav-item @(isPrivacyPage ? "active" : string.Empty)" asp-area="" asp-page="/Privacy">
                    <span class="side-nav-icon" aria-hidden="true">i</span>
                    <span>Data Privacy</span>
                </a>
            </nav>
        </aside>

        <main class="app-content" role="main">
            @RenderBody()
        </main>
    </div>

    <footer class="app-footer">
        <span>&copy; 2026 SapSuc HR</span>
        <a asp-area="" asp-page="/Privacy">Data Privacy</a>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
